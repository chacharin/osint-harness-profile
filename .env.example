# =============================================================================
# Harness-server — Hermes สำหรับรัน profile osint — ตัวอย่างไฟล์ .env
# -----------------------------------------------------------------------------
# ไฟล์นี้ใช้กับ docker compose เท่านั้น (คัดลอกเป็น .env ไว้ข้าง docker-compose.yml)
# ส่วนค่าของเอเจนต์ เช่น API key ของ LLM อยู่ใน data/profiles/osint/.env (ดู .env.template)
# บรรทัดที่มี # นำหน้าคือค่าเริ่มต้น หากไม่กำหนดในไฟล์ .env ระบบจะใช้ค่านี้
# เมื่อแก้ไขไฟล์ .env แล้ว ให้สั่ง docker compose up -d เพื่อสร้าง container ใหม่
# =============================================================================

# --- docker compose ---
# image ของ Hermes ที่ใช้ ชุดติดตั้งนี้ทดสอบกับเวอร์ชัน v0.21.6
#   ก่อนเปลี่ยนเวอร์ชัน ควรทดสอบว่า SOUL, skill และ MCP server ยังทำงานได้ครบ
# HERMES_IMAGE=nousresearch/hermes-agent:v0.21.6
# uid/gid ที่ Hermes ใช้ภายใน container ซึ่งจะเป็นเจ้าของไฟล์ที่ Hermes เขียนในโฟลเดอร์ data/
#   หาก MCP server ตัวอื่นต้องเขียนไฟล์ใน workspace เดียวกัน (เช่น mcp-thai-proofread) ให้ใช้ uid/gid เดียวกัน
# HERMES_UID=10000
# HERMES_GID=10000
# docker network ที่ใช้ร่วมกับแอปและ MCP server (ต้องสร้างก่อนด้วยคำสั่ง docker network create <ชื่อ>)
# DOCKER_NETWORK=agent_network
# 0.0.0.0 = เครื่องอื่นในเครือข่ายเปิด dashboard ได้ · 127.0.0.1 = เปิดได้เฉพาะเครื่องนี้
# DASHBOARD_PUBLISH_ADDR=0.0.0.0
# พอร์ตของ dashboard บนเครื่อง
# DASHBOARD_PUBLISH_PORT=9119
