# Hermes keeps all its state under data/ (credentials, sessions, databases, caches, every profile).
# Nothing there belongs in git: the agent itself ships at the repo root as a profile distribution.
data/

# compose settings of one deployment - .env.example is the template; .env.template is the profile's
.env
.env.*
!.env.example
!.env.template

# old snapshots kept only on the host
_archive/
_to_delete/
*.zip
*.bak
*.bak-*
*.tar.gz
