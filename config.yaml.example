# =============================================================================
# Harness-server — ค่าที่ชุดติดตั้งนี้ตั้งเองใน data/config.yaml
# -----------------------------------------------------------------------------
# Hermes สร้างไฟล์ data/config.yaml เองตอนเริ่มทำงานครั้งแรก ซึ่งมีค่าเริ่มต้นและคำอธิบายของทุกหัวข้อครบแล้ว
# ไฟล์นี้รวบรวมเฉพาะค่าที่ต่างจากค่าเริ่มต้น ให้นำแต่ละค่าไปแทนค่าเดิมในหัวข้อเดียวกันของ data/config.yaml
# (ค่าที่ไม่มีในไฟล์นี้ให้คงไว้ตามที่ Hermes สร้าง) แล้วสั่ง docker compose restart gateway
# =============================================================================

# --- LLM ---
model:
  default: google/gemma-4-31b-it   # model บน OpenRouter ควรเลือก model ที่รองรับภาษาไทยและการเรียกใช้เครื่องมือได้ดี
  provider: openrouter             # ใช้ OPENROUTER_API_KEY ใน data/.env
  base_url: ''
  api_mode: chat_completions

# --- การทำงานของเอเจนต์ ---
agent:
  max_turns: 150                   # จำนวนรอบเรียกเครื่องมือสูงสุดต่อหนึ่งคำสั่ง (ค่าเริ่มต้นของ Hermes คือ 500) ป้องกันการวนไม่รู้จบ
terminal:
  cwd: /opt/data/workspace         # โฟลเดอร์ทำงานของเอเจนต์ ไฟล์ที่บันทึกตามกฎข้อ 3 ใน SOUL.md จะอยู่ที่นี่ (บนเครื่องคือ data/workspace)

# --- เครื่องมือ ---
# ชุดเครื่องมือเมื่อใช้งานผ่าน Hermes CLI ส่วน API ที่แอปเรียก (/v1) ใช้ชุดเครื่องมือมาตรฐานของ API server
# รายการช่องทางแชทอื่น (telegram, discord, slack ฯลฯ) ที่ Hermes ใส่มาให้ ตัดออกได้ หากไม่ได้ใช้ช่องทางนั้น
platform_toolsets:
  cli: [browser, code_execution, computer_use, connections, context_engine, cronjob, delegation, file, memory, session_search, skills, terminal, todo, web]
browser:
  backend: browser-use
computer_use:
  backend: cua

# --- MCP servers ---
# แต่ละตัวต้องทำงานอยู่ใน docker network เดียวกับ Hermes ก่อน (ดูลิงก์ใน README)
# timeout ต้องนานกว่าเวลาที่เครื่องมือใช้จริง มิฉะนั้นเอเจนต์จะเห็นว่าการเรียกล้มเหลวทั้งที่ server ยังทำงานอยู่
mcp_servers:
  perplexity:                      # ค้นหาเว็บและถามตอบผ่าน Perplexity (github.com/chacharin/mcp-perplexity)
    url: http://mcp-perplexity:8080/mcp
    timeout: 600                   # perplexity_research อาจใช้เวลาหลายนาที
  thai_proofread:                  # ตรวจและแก้คำสะกดภาษาไทย (github.com/chacharin/mcp-thai-proof-md)
    url: http://mcp-thai-proofread:8800/mcp
    timeout: 900                   # เอกสารยาวอาจใช้เวลาหลายนาที
  lightrag:                        # คลังความรู้ LightRAG (github.com/chacharin/mcp-lightrag)
    url: http://mcp-lightrag:8700/mcp
    timeout: 180                   # ต้องนานกว่า QUERY_TIMEOUT_SECONDS ของ mcp-lightrag (120)
