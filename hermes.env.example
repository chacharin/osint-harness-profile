# =============================================================================
# Harness-server — ค่าของเอเจนต์ที่ต้องมีในไฟล์ data/.env
# -----------------------------------------------------------------------------
# ⚠ ไฟล์นี้เป็นคำอธิบาย ไม่ต้องคัดลอกไปทับ
#   Hermes สร้างไฟล์ data/.env เองตอนเริ่มทำงานครั้งแรก (มีคำอธิบายตัวแปรอื่นของ Hermes อยู่แล้ว)
#   ให้ใส่หรือตรวจค่าด้านล่างในไฟล์นั้น แล้วสั่ง docker compose restart gateway
#   ควรแก้ data/.env ขณะที่ Hermes หยุดทำงาน เพราะ Hermes อาจเขียนไฟล์นี้ระหว่างทำงาน
# =============================================================================

# --- LLM ---
# OpenRouter API key (ค่าลับ) ใช้กับ LLM ที่เอเจนต์ใช้คิดและทำงาน (model กำหนดใน data/config.yaml)
#   ควรแยก key หรือวงเงินจาก key ที่ LightRAG ใช้ทำ embedding
#   มิฉะนั้นเมื่อเอเจนต์ใช้วงเงินหมด คลังความรู้จะค้นหาไม่ได้ไปด้วย
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- API ของเอเจนต์ ---
# key สำหรับเรียก API ของเอเจนต์ที่ http://hermes:8642/v1 (ค่าลับ) Hermes สร้างให้เองตอนติดตั้ง
#   แอปที่เรียกเอเจนต์ต้องส่ง "Authorization: Bearer <ค่านี้>" ทุกครั้ง
#   หากเปลี่ยน ต้องรีสตาร์ต Hermes และแอปที่ใช้ค่านี้ด้วย
API_SERVER_KEY=change-me
