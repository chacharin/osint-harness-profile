# =============================================================================
# .env ของ profile osint — คัดลอกเป็น .env ในโฟลเดอร์ของ profile แล้วใส่ค่าจริง
#   Docker: /opt/data/profiles/osint/.env (บนเครื่องคือ data/profiles/osint/.env)
#   ติดตั้งแบบปกติ: ~/.hermes/profiles/osint/.env
# Hermes ติดตั้งไฟล์นี้ไว้เป็น .env.EXAMPLE เพื่อไม่ให้ทับ .env จริง
# เมื่อแก้แล้ว gateway จะอ่านค่าใหม่ภายในไม่เกิน 30 วินาที หรือสั่ง docker compose restart gateway
# =============================================================================

# --- LLM ---
# OpenRouter API key (ค่าลับ) ใช้กับ LLM ที่เอเจนต์ใช้คิดและทำงาน (model กำหนดใน config.yaml)
#   ควรแยก key หรือวงเงินจาก key ที่ LightRAG ใช้ทำ embedding
#   มิฉะนั้นเมื่อเอเจนต์ใช้วงเงินหมด คลังความรู้จะค้นหาไม่ได้ไปด้วย
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- API ของเอเจนต์ ---
# key สำหรับเรียก API ของ profile นี้ที่ http://hermes:8642/p/osint/v1 (ค่าลับ) ตั้งเป็นค่าสุ่มยาว ๆ เช่น
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   แอปที่เรียกเอเจนต์ต้องส่ง "Authorization: Bearer <ค่านี้>" ทุกครั้ง และ key นี้แยกจากของ profile default
API_SERVER_KEY=change-me
